# Porta em que o servidor Express vai escutar
PORT=3000

# Token de uma Private App do HubSpot com escopo para ler/editar contatos e negócios
# (crm.objects.contacts.read, crm.objects.deals.read, crm.objects.deals.write)
HUBSPOT_TOKEN=your_hubspot_private_app_token

# Token do Bot do Slack (começa com xoxb-), com escopo chat:write
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Quando "true", o serviço NÃO chama HubSpot/Slack de verdade: apenas loga o que
# faria. Útil para validar a lógica de round-robin e o fluxo antes de configurar
# tokens e IDs reais. Deixe "false" em produção.
DRY_RUN=true
