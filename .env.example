# Porta em que o servidor Express vai escutar
PORT=3000

# Token de uma Private App do HubSpot com escopo para ler/editar contatos e negócios
# (crm.objects.contacts.read, crm.objects.deals.read, crm.objects.deals.write)
HUBSPOT_TOKEN=your_hubspot_private_app_token

# Token do Bot do Slack (começa com xoxb-), com escopos:
#   chat:write               -> postar nos canais dos times
#   channels:history / groups:history -> ler o canal #mkt-sales-leads (privado)
# IMPORTANTE: o bot precisa ser ADICIONADO ao canal #mkt-sales-leads
# (Slack > canal > Integrações > Adicionar app), senão o polling falha com
# "not_in_channel".
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Quando "true", o serviço NÃO chama HubSpot/Slack de verdade: apenas loga o que
# faria. Útil para validar a lógica de round-robin e o fluxo antes de configurar
# tokens e IDs reais. Deixe "false" em produção.
DRY_RUN=true

# --- Ingestão automática do canal #mkt-sales-leads ---
# Liga/desliga o polling periódico do canal onde o HubSpot posta os leads
# inbound novos. Precisa de SLACK_BOT_TOKEN configurado (veja acima).
SLACK_POLL_ENABLED=false
SLACK_POLL_INTERVAL_MS=30000

# ID do canal a monitorar (padrão: #mkt-sales-leads da VOLL)
SLACK_LEADS_CHANNEL_ID=C04365S730B

# Só processa mensagens desse segmento (ignora MID MARKET, KEY ACCOUNT, etc.)
SLACK_LEAD_SEGMENT=LARGE/ENTERPRISE
